<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="engineeringDocsTab" label="工程资料">
        <group id="engineeringDocsGenerateGroup" label="资料生成">
          <button id="btnOpenPanel" label="工程信息" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnGenerateCurrent" label="资料生成" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
        </group>
        <group id="engineeringDocsManageGroup" label="系统">
          <button id="btnTemplates" label="模板管理" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnModules" label="模块管理" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnKnowledge" label="知识库管理" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnActivation" label="软件激活" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnSettings" label="设置" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnEnvironmentCheck" label="环境自检" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
          <button id="btnViewLogs" label="查看日志" onAction="OnAction" getEnabled="OnGetEnabled" visible="true" size="large"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
